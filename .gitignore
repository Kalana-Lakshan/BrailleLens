# Stage 2–4 generated data (rebuild with the data_pipeline / cell_detect CLIs)
data_pipeline/crops/
data_pipeline/manifests/
cell_detect/datasets/
cell_detect/runs/
cell_detect/weights/*.pt
cell_detect/**/*.pt
cell_detect/**/*.zip
colab_upload/
# Validated Stage 4a checkpoint (mAP50 0.7607) -- tracked
!cell_detect/weights/braille_cell_best.pt
# Gold-page fine-tuned Stage 4a checkpoint -- tracked (no longer the active app default;
# see braille_cell_lighting_negatives.pt below)
!cell_detect/weights/braille_cell_gold.pt
# Camera-degradation-augmented Stage 4a checkpoint (see cell_detect/CAMERA_DEGRADATION.md) -- tracked
!cell_detect/weights/braille_cell_gold_degraded.pt
# Hard-negative-trained Stage 4a checkpoint, built on braille_cell_gold.pt (see
# cell_detect/make_synthetic_negatives.py) -- superseded as the active default once
# braille_cell_lighting.pt was tracked, by fine-tuning the same hard negatives on top of
# that checkpoint instead -- tracked for history/comparison
!cell_detect/weights/braille_cell_gold_negatives.pt
# Teammate's lighting-robust + Braille-free-negatives checkpoint (built on
# braille_cell_gold_degraded.pt -- see lighting_robust/results/) -- tracked
!cell_detect/weights/braille_cell_lighting.pt
# Our hard negatives (cell_detect/make_synthetic_negatives.py) fine-tuned on top of
# braille_cell_lighting.pt -- adopted as the active app default: best full-pipeline
# text accuracy measured this session (89.9% letters-only vs 88.2% for the parent
# checkpoint) -- see reports/eval/gold_text.md -- tracked
!cell_detect/weights/braille_cell_lighting_negatives.pt

# Trained CNN weights (large; send back from Colab, do not commit)
braille_cnn/checkpoints/*.pt
braille_cnn/checkpoints/*.npy
# Validated Stage 4b checkpoint (99.56% Angelina val acc) -- tracked
!braille_cnn/checkpoints/braille_cnn_mixed.pt
# Gold-page fine-tuned Stage 4b checkpoint (95.93% held-out gold pg-10/11 acc) -- tracked
!braille_cnn/checkpoints/braille_cnn_gold_finetuned.pt

